# Copy to `.env` and fill in your real values. Never commit `.env`.
# All five databases share this file. Only the platforms you benchmark
# need their values filled in.

# --- CognoDB Cloud (subject) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
COGNODB_DATABASE=neo4j

# --- Neo4j Aura ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Memgraph Cloud ---
MEMGRAPH_HOST=<host>
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph
MEMGRAPH_TLS=true

# --- FalkorDB Cloud ---
FALKORDB_HOST=<host>
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=pokec
FALKORDB_TLS=true

# --- ArangoDB Cloud ---
ARANGO_URL=https://<host>:8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=
ARANGO_DATABASE=_system
